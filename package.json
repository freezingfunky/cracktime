{
  "name": "ai-password-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:popup": "BUILD_TARGET=popup vite build",
    "build:content": "BUILD_TARGET=content vite build",
    "build:background": "BUILD_TARGET=background vite build",
    "build:assets": "cp -r public/* dist/",
    "build": "npm run build:popup && npm run build:content && npm run build:background && npm run build:assets",
    "dev": "npm run build && echo 'Load dist/ as unpacked extension in chrome://extensions'"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
